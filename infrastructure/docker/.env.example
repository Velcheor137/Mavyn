# Copy to .env next to compose.yaml and change every value marked CHANGE ME.
# Never commit the real .env.

# CHANGE ME: long random string, e.g. `openssl rand -base64 32`
POSTGRES_PASSWORD=

# Public URL users open in the browser (enables strict Origin checks). Example:
# PUBLIC_ORIGIN=https://notes.example.com
PUBLIC_ORIGIN=

# Keep true behind HTTPS. Set false only for plain-HTTP testing on localhost.
COOKIE_SECURE=true
# true when running behind Caddy/Nginx/Traefik on the same host (for rate limiting by client IP).
TRUST_PROXY=false

BIND_HOST=127.0.0.1
HTTP_PORT=8080
MAX_DOCUMENT_BYTES=16777216
SESSION_TTL_DAYS=30
RUST_LOG=info
